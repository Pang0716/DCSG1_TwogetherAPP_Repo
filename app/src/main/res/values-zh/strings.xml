    <!-- About descriptions -->
    <string name="about_venue_1">位于%1$s中心的豪华婚礼场地。我们提供优雅的环境、清真餐饮及可定制的套餐，让您的大日子难以忘怀。</string>
    <string name="about_venue_2">位于%1$s的优雅活动空间，提供宽敞的宴会厅及全方位活动支持，实现您的婚礼梦想。</string>
    <string name="about_venue_3">位于%1$s的顶级婚礼场地，以精致的室内设计和专业的活动团队著称，确保庆典顺利进行。</string>
    <string name="about_photographer_1">总部位于%1$s的专业婚礼摄影团队，以永恒优雅的风格捕捉每一个真实与摆拍的瞬间。</string>
    <string name="about_photographer_2">位于%1$s的经验丰富摄影工作室，擅长通过精美构图的婚礼影像讲述故事。</string>
    <string name="about_photographer_3">位于%1$s的创意摄影团队，融合纪实与艺术风格，为您珍藏特别的一天。</string>
    <string name="about_makeup_1">位于%1$s的专业新娘化妆工作室，擅长打造完美持久、贴合婚礼主题的妆容。</string>
    <string name="about_makeup_2">位于%1$s的经验丰富新娘美容团队，为新娘及其伴娘提供个性化化妆及发型服务。</string>
    <string name="about_makeup_3">位于%1$s值得信赖的化妆工作室，以自然容光焕发的新娘妆容闻名，妆效持久贯穿整场庆典。</string>
    <string name="about_liveband_1">总部位于%1$s的现场婚礼乐队，以量身定制的曲目为您的婚宴带来活力与优雅。</string>
    <string name="about_liveband_2">位于%1$s的多元现场音乐组合，从浪漫民谣到动感舞曲，为您的大日子倾情演绎。</string>
    <string name="about_liveband_3">位于%1$s经验丰富的婚礼乐队，带来精致的现场演出，让宾客整晚尽兴起舞。</string>
    <string name="about_emcee_1">总部位于%1$s的经验丰富婚礼司仪，确保您的流程顺畅进行，同时全程与宾客互动。</string>
    <string name="about_emcee_2">位于%1$s的专业主持团队，以温暖与幽默贯穿您的婚礼流程，从开始到结束。</string>
    <string name="about_emcee_3">位于%1$s技艺精湛的婚礼司仪，以自信的双语主持及流畅的节奏掌控著称。</string>
    <string name="about_attire_1">位于%1$s的新娘与婚礼礼服专家，提供租赁与量身定制服务，成就您大日子的完美造型。</string>
